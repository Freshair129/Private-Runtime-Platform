	subgraph cluster_0 {
		color="#B7C6D1" fontcolor="#344B5E" fontsize=13 label="User-visible outcome (terminal immutable)" style=rounded
		p [label=PENDING fillcolor="#E9F3F8" shape=box]
		su [label=SUCCEEDED fillcolor="#E5F3ED" shape=box]
		fa [label=FAILED fillcolor="#FDECE6" shape=box]
		to [label=TIMED_OUT fillcolor="#FDECE6" shape=box]
		ca [label=CANCELLED fillcolor="#FDECE6" shape=box]
	}
	subgraph cluster_1 {
		color="#B7C6D1" fontcolor="#344B5E" fontsize=13 label="Execution evidence (independent)" style=rounded
		q [label=QUEUED fillcolor="#E9F3F8" shape=box]
		res [label=RESERVED fillcolor="#E9F3F8" shape=box]
		dis [label="DISPATCHED / RUNNING" fillcolor="#E9F3F8" shape=box]
		un [label=UNKNOWN fillcolor="#FDECE6" shape=box]
		fin [label=FINISHED fillcolor="#E5F3ED" shape=box]
	}
	subgraph cluster_2 {
		color="#B7C6D1" fontcolor="#344B5E" fontsize=13 label="Invocation resource lease" style=rounded
		held [label=HELD fillcolor="#FFF4DB" shape=box]
		quar [label=QUARANTINED fillcolor="#FDECE6" shape=box]
		rel [label=RELEASED fillcolor="#E5F3ED" shape=box]
	}
	p -> su [label="Valid result" style=solid]
	p -> fa [label="Known failure" style=solid]
	p -> to [label=Deadline style=solid]
	p -> ca [label="Cancellation outcome" style=solid]
	q -> res [label="" style=solid]
	res -> dis [label="" style=solid]
	dis -> fin [label="Verified finish" style=solid]
	dis -> un [label="Ambiguous response" style=solid]
	un -> fin [label="Evidence only" style=solid]
	held -> quar [label="Unknown computation" style=solid]
	held -> rel [label="Verified finish / no send" style=solid]
	quar -> rel [label="Termination evidence" style=solid]
	rankdir=TB
	rankdir=LR
	rankdir=TB
}
