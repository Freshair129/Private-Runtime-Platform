# EV08 candidate A - environment export. Secrets are REDACTED and must be supplied at import.
XINFERENCE_HOME=<set per host>
XINFERENCE_AUTH_JWT_SECRET_KEY=<REDACTED - generate per host>
XINFERENCE_AUTH_ENCRYPTION_KEY=<REDACTED - generate per host>
# defaults in force during this run (not set explicitly):
# XINFERENCE_AUTH_ADVANCED=true (auth on)
# XINFERENCE_BATCH_SIZE=32
# XINFERENCE_BATCH_INTERVAL=0.003
# XINFERENCE_MAX_CONCURRENT_LAUNCHES=5
# XINFERENCE_MODEL_ACTOR_AUTO_RECOVER_LIMIT=<unset = unbounded>
# weights must exist at the model_uri in model-registration.json, reachable via a directory
# junction at <XINFERENCE_HOME>/cache/v2/prp-typhoon25-qwen3-4b-pytorch-4b-none (Windows: no
# symlink privilege needed for a junction)
